; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Griss"
run/main_scene="res://game/Main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.png"

[audio]

; iOS silences the default session category ("Ambient", 0) whenever the
; hardware Ring/Silent switch is set to silent. These effects are gameplay
; feedback, not background music, so use "Playback" (3), which sounds
; regardless of the switch. Note the editor strips these comments on save -
; the reasoning lives in plans/done/implement-sound-effects.md.
general/ios/session_category=3

[display]

window/size/viewport_width=480
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[physics]

common/enable_pause_aware_picking=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
